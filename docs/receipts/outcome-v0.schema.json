{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://use05.dev/receipts/outcome-v0.schema.json",
  "title": "05 outcome receipt, https://use05.dev/outcome/v0",
  "description": "An in-toto Statement v1 carrying what the author said they did, for the tree they finished on. An assertion, never a fact. Fields are only ever added, as optional ones.",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "additionalProperties": true,
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": { "name": { "type": "string" }, "digest": { "type": "object", "additionalProperties": { "type": "string" } } }
      },
      "contains": {
        "type": "object",
        "properties": { "name": { "const": "tree" }, "digest": { "type": "object", "required": ["gitTree", "sha256"] } }
      }
    },
    "predicateType": { "const": "https://use05.dev/outcome/v0" },
    "predicate": {
      "type": "object",
      "required": ["task", "outcome", "finished"],
      "additionalProperties": true,
      "properties": {
        "task": { "type": "string" },
        "outcome": { "type": "string" },
        "finished": { "type": "string" },
        "base": { "type": ["string", "null"], "description": "Where the finished work met the landing branch when the task finished, when known." }
      }
    }
  }
}
