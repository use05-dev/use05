{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://use05.dev/receipts/log-v0.schema.json",
  "title": "05 log seal, https://use05.dev/log/v0",
  "description": "An in-toto Statement v1 sealing an agent's action log: the log of the task had seq lines and the last had chain hash head. Fields are only ever added, as optional ones.",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "additionalProperties": true,
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": { "name": { "type": "string" }, "digest": { "type": "object", "additionalProperties": { "type": "string" } } }
      },
      "contains": {
        "type": "object",
        "properties": { "name": { "const": "log" }, "digest": { "type": "object", "required": ["task", "sha256"] } }
      }
    },
    "predicateType": { "const": "https://use05.dev/log/v0" },
    "predicate": {
      "type": "object",
      "required": ["task", "seq", "head", "created"],
      "additionalProperties": true,
      "properties": {
        "task": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 },
        "head": { "type": "string", "description": "The chain hash of line seq." },
        "created": { "type": "string" }
      }
    }
  }
}
