{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://use05.dev/receipts/org-layer-v0.schema.json",
  "title": "05 organisation policy floor, https://use05.dev/org-layer/v0",
  "description": "An in-toto Statement v1 carrying a policy floor issued by an organisation, signed with a key the repository cannot change. Fields are only ever added, as optional ones.",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "additionalProperties": true,
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": { "name": { "type": "string" }, "digest": { "type": "object", "additionalProperties": { "type": "string" } } }
      }
    },
    "predicateType": { "const": "https://use05.dev/org-layer/v0" },
    "predicate": {
      "type": "object",
      "required": ["org", "floor", "created"],
      "additionalProperties": true,
      "properties": {
        "org": { "type": "string" },
        "floor": { "type": "object", "description": "Has the policy file's shape; 05 interprets it." },
        "created": { "type": "string" }
      }
    }
  }
}
