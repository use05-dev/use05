{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://use05.dev/receipts/intent-v0.schema.json",
  "title": "05 declaration receipt, https://use05.dev/intent/v0",
  "description": "An in-toto Statement v1 carrying an agent's sealed declaration of what it will do. Subject: the intent card digest. The person's request is never in it. Fields are only ever added, as optional ones.",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "additionalProperties": true,
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": { "name": { "type": "string" }, "digest": { "type": "object", "additionalProperties": { "type": "string" } } }
      },
      "contains": {
        "type": "object",
        "properties": { "name": { "const": "intent" }, "digest": { "type": "object", "required": ["sha256"] } }
      }
    },
    "predicateType": { "const": "https://use05.dev/intent/v0" },
    "predicate": {
      "type": "object",
      "required": ["task", "title", "author", "card", "sealed", "policy_sha256"],
      "additionalProperties": true,
      "properties": {
        "task": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "card": { "type": "object", "description": "The intent card: scope, acceptance checks, goal." },
        "sealed": { "type": "string" },
        "policy_sha256": { "type": "string" },
        "agent": {
          "type": "object",
          "required": ["kind", "session"],
          "description": "Which agent declared it.",
          "properties": { "kind": { "type": "string" }, "session": { "type": "string" }, "model": { "type": "string" } }
        },
        "owner": {
          "type": "object",
          "required": ["name", "key_id"],
          "description": "The accountable person as recorded; their signed approval confirms it.",
          "properties": { "name": { "type": "string" }, "key_id": { "type": "string" } }
        },
        "sandbox": { "type": "string", "description": "The agent's own report of its sandbox; its word, not a fact." }
      }
    }
  }
}
